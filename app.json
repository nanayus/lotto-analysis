{
  "expo": {
    "name": "Lotto Insight",
    "slug": "lotto",
    "version": "1.0.2",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4c4a3751-a6d1-4efa-b5ac-6cfda28a53e4"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lotto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/images/ios-app-icon.png",
      "bundleIdentifier": "net.wondly.lottoinsight",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "net.wondly.lottoinsight",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Lotto Insight",
      "shortName": "Lotto Insight",
      "lang": "ko",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait",
      "themeColor": "#080A12",
      "backgroundColor": "#080A12",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/images/brand-splash.png",
            "imageWidth": 340,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c4a3751-a6d1-4efa-b5ac-6cfda28a53e4"
      }
    },
    "owner": "purplehippos"
  }
}
