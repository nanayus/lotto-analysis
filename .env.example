# Firebase Web app configuration (public identifiers, not Admin credentials)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=lotto-analyzer-6e624.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=lotto-analyzer-6e624
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-0C2D8KS9Q8
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-northeast3
EXPO_PUBLIC_ANALYTICS_ENABLED=
EXPO_PUBLIC_PRO_PLAN_ENABLED=false
EXPO_PUBLIC_RESULT_ADS_ENABLED=false
EXPO_PUBLIC_ACCOUNT_LINKING_ENABLED=false

# AdMob. TestFlight testing should use EXPO_PUBLIC_ADMOB_TEST_MODE=true so only
# Google's sample app/ad-unit IDs are compiled into that build.
EXPO_PUBLIC_ADMOB_TEST_MODE=false
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_AD_UNIT_ID=

# RevenueCat public SDK keys (public identifiers; never put a secret sk_ key here)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# OAuth client identifiers
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Google iOS Client ID를 뒤집은 URL scheme: com.googleusercontent.apps.xxxxx
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_APPLE_SERVICE_ID=
EXPO_PUBLIC_APPLE_ANDROID_REDIRECT_URI=https://lotto.wondly.net/auth/callback
