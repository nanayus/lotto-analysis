{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_MODE": "true",
        "EXPO_PUBLIC_PRO_PLAN_ENABLED": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6808632398"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6808632398"
      }
    }
  }
}
